# ============================================================
# 📋 .env.example — TEMPLATE (Safe to Commit)
# BOSC Tech & Edu · Hoṛ Katha Suite v3.7.4 Pro Ultra
# ============================================================
#
# ⚠️ IMPORTANT:
#    This is a TEMPLATE file. Copy this to `.env` and fill in
#    your real values. NEVER commit the actual `.env` file to Git.
#
# Usage:
#   1. Copy this file:     cp .env.example .env
#   2. Fill real values in .env
#   3. Verify .env is in .gitignore
#   4. For production: use environment variable services
#
# ════════════════════════════════════════════════════════════
# 🔒 SECURITY LEVELS:
#   🔴 CRITICAL — Never share, never commit
#   🟠 HIGH    — Sensitive, restrict access
#   🟡 MEDIUM  — Limit distribution
#   🟢 LOW     — Public OK
# ════════════════════════════════════════════════════════════
#
# 📋 Quick Checklist:
#   [ ] Copied .env.example → .env
#   [ ] Filled all values below
#   [ ] .env is in .gitignore
#   [ ] No real values in .env.example
#   [ ] Production env vars set (Vercel/Netlify)
#   [ ] NAME_ENCRYPTION_SECRET generated (32+ chars)
#   [ ] License JWK generated (admin/keygen.html)
#
# ⚠️ CRITICAL RULES:
#   1. Values के आसपास QUOTES नहीं लगाएँ
#   2. Spaces नहीं डालें = के आसपास
#   3. Public Key 43 characters की होनी चाहिए (X और Y दोनों)
#   4. Values case-sensitive हैं
#   5. NAME_ENCRYPTION_SECRET minimum 16 chars (32+ recommended)
# ════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════
# 📱 APP INFO (🟢 LOW — Public)
# ═══════════════════════════════════════════════════════════
APP_NAME=Hoṛ Katha Suite
APP_VERSION=3.7.4
APP_ENV=production
APP_DEBUG=false
NODE_ENV=production
ELECTRON_ENABLE_LOGGING=false
ELECTRON_DISABLE_SECURITY_WARNINGS=false

# ═══════════════════════════════════════════════════════════
# 🔐 LICENSE PUBLIC KEY — ECDSA P-256 (🟠 HIGH)
# ═══════════════════════════════════════════════════════════
# Generate using: admin/keygen.html
# ⚠️ ONLY PUBLIC key goes here (never private key!)
# ⚠️ Values should be exactly 43 characters each
# ⚠️ Do NOT wrap values in quotes
#
# Option 1 (Recommended): Full JWK as JSON string (single line)
#   LICENSE_PUBLIC_KEY_JWK={"kty":"EC","crv":"P-256","x":"...","y":"..."}
#
# Option 2: Individual X/Y coordinates
# ═══════════════════════════════════════════════════════════

# OPTIONAL — Full JWK as single-line JSON (highest priority)
# Uncomment and fill if using JWK format:
# LICENSE_PUBLIC_KEY_JWK={"kty":"EC","crv":"P-256","x":"YOUR_X_HERE","y":"YOUR_Y_HERE"}

# REQUIRED (if JWK not used) — Individual coordinates (43 chars each)
LICENSE_PUBLIC_KEY_KTY=EC
LICENSE_PUBLIC_KEY_CRV=P-256
LICENSE_PUBLIC_KEY_X=YOUR_X_COORDINATE_HERE
LICENSE_PUBLIC_KEY_Y=YOUR_Y_COORDINATE_HERE

# ═══════════════════════════════════════════════════════════
# 📞 CONTACT INFO (🟡 MEDIUM)
# ═══════════════════════════════════════════════════════════
# Format: 919110977117 (for +91 91109 77117)
SUPPORT_WHATSAPP=YOUR_WHATSAPP_NUMBER_HERE
SELLER_EMAIL=YOUR_EMAIL_HERE
DEVELOPER_URL=https://example.com

# ═══════════════════════════════════════════════════════════
# 💰 PAYMENT (UPI) (🟠 HIGH)
# ═══════════════════════════════════════════════════════════
UPI_PRIMARY_ID=YOUR_UPI_ID_HERE
UPI_NPCI_ID=YOUR_NPCI_ID_HERE
PAYEE_NAME=YOUR_PAYEE_NAME_HERE

# ═══════════════════════════════════════════════════════════
# 📊 FIREBASE TRACKING (🟠 HIGH)
# ═══════════════════════════════════════════════════════════
# Leave TRACKING_ENDPOINT empty to disable tracking
# ═══════════════════════════════════════════════════════════
TRACKING_ENDPOINT=

FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
FIREBASE_DATABASE_URL=https://YOUR_PROJECT-default-rtdb.REGION.firebasedatabase.app
FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
FIREBASE_APP_ID=YOUR_APP_ID
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ═══════════════════════════════════════════════════════════
# 🔐 NAME ENCRYPTION SECRET (🔴 CRITICAL — REQUIRED IN PRODUCTION)
# ═══════════════════════════════════════════════════════════
# Customer names को AES-256 से encrypt करने के लिए
#
# ⚠️ REQUIREMENTS:
#   • Minimum 16 characters (32+ HIGHLY recommended)
#   • Use random mix of letters, numbers, symbols
#   • MUST be SAME in tracker.js and dashboard.html
#   • एक बार set करके कभी न बदलें (data loss risk)
#
# 🔧 HOW TO GENERATE:
#   Option 1 (Linux/Mac): openssl rand -base64 32
#   Option 2 (Node.js):   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#   Option 3 (Online):    https://randomkeygen.com (use "CodeIgniter Encryption Keys")
#
# ⚠️ PRODUCTION BEHAVIOR:
#   • If missing in packaged .exe → App will REFUSE TO START
#   • If missing in dev mode → Warning only
# ═══════════════════════════════════════════════════════════
NAME_ENCRYPTION_SECRET=YOUR_STRONG_SECRET_MIN_16_CHARS

# ═══════════════════════════════════════════════════════════
# 💳 LICENSE PLANS (🟡 MEDIUM)
# ═══════════════════════════════════════════════════════════
PLAN_P1_PRICE=199
PLAN_P1_DEVICES=1
PLAN_P1_NAME=Community

PLAN_P2_PRICE=399
PLAN_P2_DEVICES=3
PLAN_P2_NAME=Commercial

PLAN_P3_PRICE=699
PLAN_P3_DEVICES=5
PLAN_P3_NAME=Enterprise

# ═══════════════════════════════════════════════════════════
# 🎁 TRIAL SETTINGS (🟡 MEDIUM)
# ═══════════════════════════════════════════════════════════
TRIAL_ENABLED=true
TRIAL_PRICE=9
TRIAL_DURATION_DAYS=7
TRIAL_KEY_PREFIX=HKT

TRIAL_STORAGE_KEY=hor_trial_start
TRIAL_DEVICE_KEY=hor_trial_device
TRIAL_KEY_STORAGE=hor_trial_key
TRIAL_WARNING_DAYS=6,7

# ═══════════════════════════════════════════════════════════
# 🌐 DEPLOYMENT (🟢 LOW)
# ═══════════════════════════════════════════════════════════
# Development: http://localhost:8080
# Production:  https://hor-katha.vercel.app
BASE_URL=http://localhost:8080

# ═══════════════════════════════════════════════════════════
# 🌐 TRUSTED EXTERNAL HOSTS (🟠 HIGH)
# ═══════════════════════════════════════════════════════════
# Comma-separated list of hosts that Electron can open externally
# Used in main.js for URL whitelist validation
#
# ⚠️ SECURITY NOTE:
#   • Use SPECIFIC domains, not wildcards
#   • Good: 'hor-katha.vercel.app'
#   • Bad:  'vercel.app' (allows any Vercel site)
# ═══════════════════════════════════════════════════════════
TRUSTED_EXTERNAL_HOSTS=wa.me,whatsapp.com,api.whatsapp.com,web.whatsapp.com,formsubmit.co,bosctech.in,github.com,hor-katha.vercel.app,api.qrserver.com,quickchart.io,firebaseio.com,firebasedatabase.app,googleapis.com,gstatic.com,cloudflare.com,unpkg.com

# ═══════════════════════════════════════════════════════════
# 🎨 UI SETTINGS (🟢 LOW)
# ═══════════════════════════════════════════════════════════
DEFAULT_THEME=dark
DEFAULT_LANGUAGE=english
ENABLE_ANALYTICS=false
ENABLE_TELEMETRY=false

# ═══════════════════════════════════════════════════════════
# 🔒 SECURITY (🟠 HIGH)
# ═══════════════════════════════════════════════════════════
CLOCK_MAX_ROLLBACK_MINUTES=5
CLOCK_MAX_SERVER_DRIFT_MINUTES=120
CLOCK_MAX_FORWARD_JUMP_DAYS=90

# ⚠️ Patterns में special characters escape करना ज़रूरी है
LICENSE_KEY_PATTERN=^HKP-(P[1-3])-(?:\\d{4}|\\d{6})-[A-F0-9]{128}$
TRIAL_KEY_PATTERN=^HKT-\\d{7}-[A-F0-9]{4}$
HWID_PATTERN=^DVC-[A-F0-9]{4}-[A-F0-9]{4}$

# ═══════════════════════════════════════════════════════════
# 📧 EMAIL (Formsubmit.co for receipts) (🟢 LOW)
# ═══════════════════════════════════════════════════════════
FORMSUBMIT_ENDPOINT=https://formsubmit.co/ajax/YOUR_EMAIL_HERE

# ═══════════════════════════════════════════════════════════
# 🖨️ PRINT SETTINGS (🟢 LOW)
# ═══════════════════════════════════════════════════════════
PRINT_HEADER_ENABLED=true
PRINT_FOOTER_ENABLED=true
PRINT_VERSION_ENABLED=true

# ═══════════════════════════════════════════════════════════
# 🎓 CERTIFICATE (🟡 MEDIUM)
# ═══════════════════════════════════════════════════════════
CERTIFICATE_ENABLED=true
CERTIFICATE_QR_ENABLED=true
CERTIFICATE_STYLES=basic,advanced,job

# ═══════════════════════════════════════════════════════════
# ⌨️ TYPING TEST (🟢 LOW)
# ═══════════════════════════════════════════════════════════
TYPING_TEST_ENABLED=true
TYPING_TEST_DURATIONS=60,120,300,600
TYPING_TEST_MIN_WPM=20
TYPING_TEST_MAX_WPM=250

# ═══════════════════════════════════════════════════════════
# 🔊 AUDIO / TTS (🟢 LOW)
# ═══════════════════════════════════════════════════════════
TTS_ENABLED=true
TTS_CHUNK_SIZE=180
TTS_DEFAULT_RATE=1.0
TTS_DEFAULT_PITCH=1.0
TTS_DEFAULT_VOLUME=1.0

AUDIO_CLICK_ENABLED=true
AUDIO_THROTTLE_MS=400

# ═══════════════════════════════════════════════════════════
# 🌐 NETWORK (🟢 LOW)
# ═══════════════════════════════════════════════════════════
NETWORK_TIMEOUT_MS=10000
TRACKER_TIMEOUT_MS=8000

QR_PROVIDER_1=https://api.qrserver.com/v1/create-qr-code/
QR_PROVIDER_2=https://quickchart.io/qr

# ═══════════════════════════════════════════════════════════
# 🚀 PLATFORM-SPECIFIC (Production only)
# ═══════════════════════════════════════════════════════════

# ─── Vercel ────────────────────────────────────────────────
# Add to: Vercel Dashboard → Project Settings → Environment Variables
# Format for Vercel CLI:
#   vercel env add SUPPORT_WHATSAPP
# ──────────────────────────────────────────────────────────

# ─── Netlify ───────────────────────────────────────────────
# Add to: Netlify Dashboard → Site Settings → Environment
# Or use netlify.toml:
#
# [build.environment]
#   APP_ENV = "production"
# ──────────────────────────────────────────────────────────

# ─── GitHub Actions ────────────────────────────────────────
# Add to: Repository Settings → Secrets and variables → Actions
# Access in workflows as: ${{ secrets.SUPPORT_WHATSAPP }}
# ──────────────────────────────────────────────────────────

# ═══════════════════════════════════════════════════════════
# 📝 NOTES
# ═══════════════════════════════════════════════════════════
#
# 1. NEVER commit the actual `.env` file to Git
#    → Add `.env` to .gitignore
#
# 2. Copy this file to `.env` before filling values
#    → cp .env.example .env
#
# 3. For production, use environment variable services:
#    → Vercel: Project Settings → Environment Variables
#    → Netlify: Site Settings → Build & Deploy → Environment
#    → GitHub Actions: Repository Secrets
#
# 4. Real values should ONLY be in:
#    → Local .env file
#    → Vercel/Netlify dashboard
#    → GitHub Secrets
#    → preload.js (for Electron builds only — secure archive)
#
# 5. Environment Variables Explained:
#    → NODE_ENV=production         → Node.js को production mode बताता है
#    → ELECTRON_ENABLE_LOGGING     → false रखें production में
#    → ELECTRON_DISABLE_SECURITY_WARNINGS → false रखें (safety warnings दिखें)
#
# 6. Public Key format check:
#    • X coordinate should be 43 chars
#    • Y coordinate should be 43 chars
#    • Both should be base64url (A-Z, a-z, 0-9, -, _)
#
# 7. अगर License activation fail हो:
#    • Check करें कि Public Key सही है
#    • Check करें कि Private Key match करती है
#    • Check करें कि quotes नहीं लगाए
#
# 8. अगर App startup fail हो (production में):
#    • NAME_ENCRYPTION_SECRET set है verify करें
#    • Secret कम से कम 16 characters का हो
#    • .env file packaged .exe के साथ include है
#
# 9. Trusted hosts troubleshooting:
#    • अगर external link block हो रहा है → TRUSTED_EXTERNAL_HOSTS check करें
#    • Specific domain use करें (wildcards avoid करें)
#
# 10. Clock tamper tolerance:
#     • CLOCK_MAX_SERVER_DRIFT_MINUTES=120 (2 hours)
#     • CLOCK_MAX_ROLLBACK_MINUTES=5
#     • CLOCK_MAX_FORWARD_JUMP_DAYS=90
#
# ═══════════════════════════════════════════════════════════
# END OF ENVIRONMENT TEMPLATE
# ═══════════════════════════════════════════════════════════