rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return request.auth != null && (request.auth.token.email == 'bosctechedu@gmail.com' || request.auth.token.email == 'dulartolashinfo@gmail.com');
    }

    match /trials/{docId} {
      allow read, write: if false;
    }
    match /otp_tokens/{docId} {
      allow read, write: if false;
    }

    match /activations/{activationId} {
      allow read, write: if isAdmin();
    }

    match /smart_trial/keys/{key} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /recycle_bin/{docId} {
      allow read, write: if isAdmin();
    }

    match /revoked/licenses/{licKey} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /certificates/{certId} {
      allow read: if true; 
      allow write: if isAdmin();
    }

    match /admin_logs/{logId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}